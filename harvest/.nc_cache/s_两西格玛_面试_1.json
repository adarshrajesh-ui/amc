的心， 工作5年可能经历最多的就是面试了，好多工作经验都是在面试的过程发现不足，弥补不足， 想要把这几年的面试经验写个总结，希望对大家能有帮助吧！ 我这也算透露行业秘密了！...言归正传，说到SQE面试，我个人总结下来，面试官比较关心的主要有几点： 1.稳定性，稳定性！稳定性！...但是面试管还就问你这些，你说气人不？ 2.3质量工具，APQP，8D，5Why,DOE，交叉实验，错误再现！...4.有时候非常公正的为供应商说两句话，是不是感觉全公司都是你的敌人？然后背后窃窃私语，这得拿了供应商多少好处？...2.2 精益管理，不得不说最近这几年精益管理在中国越来越受欢迎，","color":null,"router":null}]},"typeName":"笔经面经","beMyOnly":false,"contentImageUrls":[],"isTop":null,"hot":false,"isGilded":false,"isReward":false,"reward":0.0,"hasOfferCompareTag":false,"staffAnswer":false,"withAnonymousOffer":false,"isAnonymousFlag":false,"isWithAcceptFlag":null,"postCertify":0,"entityId":1040580,"entityType":8,"newReferral":null,"createTime":1662350481000,"editTime":1662350481000,"recommendAd":false,"edited":false,"showTime":1662350481000},"subjectData":[],"voteData":{"voteId":0,"withVote":false,"voteTitle":null,"voteType":null},"blogZhuanlan":null,"frequencyData":{"likeCnt":16,"followCnt":87,"commentCnt":8,"totalCommentCnt":8,"viewCnt":4966,"shareCnt":2,"isLike":false,"isFollow":false,"flowerData":null},"extraInfo":{"contentType_var":"POST","trackID_var":"2gpdpwa3fo4phkcv6rr9v","contentID_var":"1040580","trackId":"2gpdpwa3fo4phkcv6rr9v","dolphin_var":";","entityId":"80001040580","searchTaxonomyEnum":null,"entityID_var":"80001040580"},"internalRecommend":null}},{"rc_type":207,"entityDataId":198092,"triggerId":null,"trackId":"2gpdpwa3fo4phkcv6rr9v","title":null,"expandType":0,"extraInfo":{"contentType_var":"POST","trackID_var":"2gpdpwa3fo4phkcv6rr9v","contentID_var":"198092","trackId":"2gpdpwa3fo4phkcv6rr9v","dolphin_var":";","entityId":"80000198092","searchTaxonomyEnum":null,"entityID_var":"80000198092"},"data":{"contentId":"353155080620810240","contentType":250,"interviewExp":null,"userBrief":{"userId":7001104,"nickname":"拒绝墨迹","admin":false,"followed":false,"headImgUrl":"https://uploadfiles.nowcoder.com/images/20190428/7001104_1556381859230_A7E0BDCDF901D47C7E09934BBE3929B9","gender":"男","headDecorateUrl":"","honorLevel":6,"honorLevelName":"飞黄腾达 Lv.5","honorLev