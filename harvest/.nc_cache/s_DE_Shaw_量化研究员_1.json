yId":1862,"identityClass":"identity-hr-icon","identityNo":8,"name":"上海思勰投资管理有限公司_行政人事部_HR","companyName":"上海思勰投资管理有限公司","jobName":"HR"}],"activityIconList":[],"activityIconListV2":[{"imgUrl":"https://static.nowcoder.com/sparta/icon/level/lv2.png","expireTime":null,"name":"等级","discussLink":null,"appLink":null,"pcLink":null,"content":null,"source":null,"type":null}],"memberIdentity":0,"memberStartTime":null,"memberEndTime":null,"member":null,"authDisplayInfo":"上海思勰投资管理有限公司 HR","enterpriseInfo":null,"badgeIconUrl":null},"contentData":{"id":"353156642218909696","uuid":"38835b7779a84ce5808dff68af195aff","authorId":"854250641","title":"【思勰投资】上海量化对冲基金2021届校招内推、往届生社招","newTitle":{"data":[{"text":"【思勰投资】上海量化对冲基金2021届校招内推、往届生社招","color":null,"router":null}]},"richText":null,"content":"主要采用量化投资策略来进行投资组合管理。 公司创始合伙人均来自海内外顶级对冲基金和投资银行（高盛、DE Shaw），曾任职于量化策略研究和交易系统开发部门。...算法策略部 一、量化研究员（Quant） 职责描述： 1.收集、分析和处理各种数据，搜集和整理业内外各类金融工程和量化投资成果； 2.对投资逻辑进行模型化，形成投资策略模型； 3.对市场及交易数据进行处理...预计在未来的几年内成为一支全策略，多元化的量化基金团队，我司的目标是打造量化领域中最优秀的私募基金公司之一。...、建模与分析； 4.参与量化策略的研发、生成可行的盈利策略，具体涉及股票、期货和期权等品种交易想法的策略化、数据处理、策略历史回测、策略跟踪评价、策略改进、策略报告撰写等； 5.对量化投资策略的表现进行跟踪...、分析和评估，参与量化对冲基金管理； 6.参与公司的专项研究课题及其他相关工作。","newContent":{"data":[{"text":"主要采用量化投资策略来进行投资组合管理。 公司创始合伙人均来自海内外顶级对冲基金和投资银行（高盛、DE Shaw），曾任职于量化策略研究和交易系统开发部门。...算法策略部 一、量化研究员（Quant） 职责描述： 1.收集、分析和处理各种数据，搜集和整理业内外各类金融工程和量化投资成果； 2.对投资逻辑进行模型化，形成投资策略模型； 3.对市场及交易数据进行处理...预计在未来的几年内成为一支全策略，多元化的量化基金团队，我司的目标是打造量化领域中最优秀的私募基金公司之一。...、建模与分析； 4.参与量化策略的研发、生成可行的盈利策略，具体涉及股票、期货和期权等品种交易想法的策略化、数据处理、策略历史回测、策略跟踪评价、策略改进、策略报告撰写等； 5.对量化投资策略的表现进行跟踪...、分析和评估，参与量化对冲基金管理； 6.参与公司的专项研究课题及其他相关工作。","color":null,"router":null}]},"typeName":"招聘信息","beMyOnly":false,"contentImageUrls":[],"isTop":null,"hot":false,"isGilded":false,"isReward":false,"reward":0.0,"hasOfferCompareTag":false,"staffAnswer":false,"withAnonymousOffer":false,"isAnonymousFlag":false,"isWithAcceptFlag":null,"postCertify":0,"entityId":458590,"entityType":8,"newReferral":null,"createTime":1595557480000,"editTime":1595557593000,"recommendAd":false,"edited":true,"showTime":1595557593000},"subjectData":[],"voteData":{"voteId":0,"withVote":false,"voteTitle":null,"voteType":null},"blogZhuanlan":null,"frequencyData":{"likeCnt":0,"followCnt":14,"commentCnt":3,"totalCommentCnt":3,"viewCnt":13164,"shareCnt":1,"isLike":false,"isFollow":false,"flowerData":null},"extraInfo":{"contentType_var":"POST","trackID_var":"2gpdxmi4ypdqad1kwvaoy","contentID_var":"458590","trackId":"2gpdxmi4ypdqad1kwvaoy","dolphin_var":";","entityId":"80000458590","searchTaxonomyEnum":null,"entityID_var":"80000458590"},"internalRecommend":null}},{"rc_type":213,"entityDataId":451871,"triggerId":null,"trackId":"2gpdxmi4ypdqad1kwvaoy","title":"DE Shaw 量化研究员-职位","expandType":1001,"extraInfo":null,"data":[{"rc_type":1001,"entityDataId":451871,"triggerId":null,"trackId":"2gpdxmi4ypdqad1kwvaoy","title":null,"expandType":0,"extraInfo":{"contentType_var":"BOSS_RECOMMEND_JOB","trackID_var":"2gpdxmi4ypdqad1kwvaoy","contentID_var":"451871","trackId":"2gpdxmi4ypdqad1kwvaoy","dolphin_var":";","entityId":"30100000451871","entityID_var":"30100000451871"},"data":{"id":451871,"status":0,"createTime":1782713481000,"updateTime":1785569581000,"companyId":21422,"bossUid":90903,"recruitType":1,"jobName":"AI模型研究员（Agent方向博士）","ext":"{\"requirements\":\"1、计算机科学、软件工程、人工智能、机器学习、自动化等相关专业。\\n2、具备扎实的代码工程能力和系统开发经验，熟练掌握Python/Pytorch算法实现和实验能力，了解VeRL/LLaMA-Factory/Swift等训练框架以及Claude code和OpenClaw等智能体框架。\\n3、具备较强的问题拆解能力、工程交付意识和团队协作精神，能够快速响应业务需求，推动技术方案从设计到落地的全周期高效执行。\\n4、具有Agent应用开发经验者优先，包括但不限于智能体工作流搭建、工具链集成、多轮对话管理、RAG系统、多Agent协作平台等；具备LLM推理优化、高性能服务部署或强化学习工程化经验者优先。\\n5、具有知名互联网企业或AI公司实习经历者优先；参与过开源项目贡献、技术社区建设或具备实际业务场景落地经验者更佳。\",\"infos\":\"1、负责记忆管理、自主决策、代码生成相关模块的开发、优化与落地，持续迭代Agent上下文管理、规划推理和工具调用等核心功能，支撑信息获取、应用生成、代码生成、办公文档处理、GUI操控等各类智能体的开发与上线；\\n2、针对预训练/后训练Agent的开发需求，设计、开发并落地复杂任务规划、Repo级长程轨迹交互、多步工具编排等高价值数据生产管线，优化管线性能与稳定性，强化Agent推理深度、决策鲁棒性及复杂场景适应能力，保障智能体核心能力的落地与拓展；\\n3、负责Agentic强化学习相关功能开发，包括单Agent和多Agent端到端RL训练模块的编码、调试与优化，构建并落地环境反馈驱动的策略优化机制，提升Agent在复杂决策场景下的泛化能力与决策准确性；\"}","jobCity":"西安","jobCityList":["西安"],"jobAddress":"华为研究所","careerJobId":143072,"careerJobName":null,"deliverBegin":1782662400000,"deliverEnd":1798732799000,"graduationYear":"2027届","refreshTime":1785479194000,"latestProcessTime":1784941405000,"feedbackDays":0,"durationDays":0,"durationMonths":0,"jobOffer":0,"eduLevel":7000,"salaryType":2,"salaryMin":25,"salaryMax":50,"salaryMonth":16,"workYearType":0,"dockSource":0,"bigChance":false,"projectId":0,"openConversation":1,"deliverId":0,"jobKeys":"数字信号处理,有线通信,移动通信","avgProcessRate":100,"autoInviteSwitch":0,"addInternRecruit":0,"jobFlagList":[],"jobFlag":0,"avgProcessDay":3,"avgProcessSec":222016,"hasSigned":false,"user":{"id":455580595,"nickname":null,"tinnyHeaderUrl":"https://static.nowcoder.com/head/425t.png","mainHeaderUrl":"https://static.nowcoder.com/head/425m.png","largeHeaderUrl":"https://static.nowcoder.com/head/425m.png","status":0,"introduction":null,"gender":"女","identity":[{"companyId":21422,"companyName":"上海华为技术有限公司","idenClass":"identity-icon","level":5,"name":"上海华为技术有限公司_招聘hr","jobName":"招聘hr"}]},"recommendInternCompany":{"tagId":21422,"picUrl":"https://uploadfiles.nowcoder.com/files/20220301/816588511_1646119882737/1b6b7ccacd74359a7f088263387ce788.jpg","companyName":"上海华为技术有限公司","industryTagNameList":["通信电子"],"scaleTagName":null,"personScales":"10000人以上","companyShortName":"上海华为技术有限公司","address":"上海","companyId":21422,"followCount":0,"projectId":0,"searchSource":0},"companyFinancing":null,"industryName":null,"allowDeliverCount":0,"secondJobType":null,"dockSourceProjectName":null,"dockSourceProjectId":null,"topTag":null,"greeting":null,"jobExpInfo":{"expId":"0","expTag":"","recReason":"综合推荐","traceId":null,"trackId":"7f4c72ed-8315-42bb-a3e6-9bf8f9484a66","entityId":30100000451871},"apiActSpecialActivity":null,"apiSimpleBossUser":{"id":90903,"userId":455580595,"avgProcessRate":100,"avgProcessDay":4,"activeTime":1785480716000,"userAppellation":"裴女士"},"videoIntroductionImage":null,"videoIntroductionUrl":null,"newestOrderScore":301,"jobBoostScore":null,"adTop":false,"mark":false,"companyTopJob":false}},{"rc_type":1001,"entityDataId":443479,"triggerId":null,"trackId":"2gpdxmi4ypdqad1kwvaoy","title":null,"expandType":0,"extraInfo":{"contentType_var":"BOSS_RECOMMEND_JOB","trackID_var":"2gpdxmi4ypdqad1kwvaoy","contentID_var":"443479","trackId":"2gpdxmi4ypdqad1kwvaoy","dolphin_var":";","entityId":"30100000443479","entityID_var":"30100000443479"},"data":{"id":443479,"status":0,"createTime":1774937282000,"updateTime":1785568215000,"companyId":27775,"bossUid":114619,"recruitType":2,"jobName":"量化研究员【实习可留用】（北京）","ext":"{\"infos\":\"【我们是谁】：\\n华钧广汇，是一家以数理统计与人工智能为核心驱动力的技术型量化私募机构。我们依托行业前沿的自研低延迟交易系统、机器学习研究框架和高性能计算平台，持续探索量化投资的技术边界。在这里，没有复杂的层级和冗长的流程，只有真实的项目、快速的反馈和持续成长的机会。无论你热衷系统开发、量化研究还是数据工程，都有机会深度参与真实业务，在研究、开发与交易落地的完整链路中验证自己的想法。\\n\\n【岗位介绍】：\\n量化研究团队专注于市场规律挖掘与策略研发，是公司投资能力建设的重要组成部分。团队依托完善的研究框架、海量历史数据及高性能计算资源，持续探索新的交易机会。\\n作为量化研究员，你将参与从因子研究到策略验证的完整研究流程，推动研究成果向实盘转化。\\n\\n【核心职责】：\\n1. 评估、优化及持续改进现有实盘量化策略。\\n2. 与Quant组一同研究数学、统计和机器学习方法，开发并测试新型交易模型。\\n3. 整理、建模并深度分析股票/期货／期权的海量交易行情。    \\n4. 开发和部署量化交易分析架构及交易平台（python／matlab）。\",\"requirements\":\"【任职要求】：\\n1. 国内外知名高校硕士及以上学历，理工科或金融相关专业。 \\n2. 具备量化研究相关工作或实习经验。 \\n3. 对应用数学、统计学及程序化交易有浓厚兴趣。 \\n4. 熟练掌握至少一种编程语言。 \\n5. 工作态度积极，具备优秀的学习能力，良好的沟通能力和团队合作精神。 \\n6. 股票、期货及其他衍生品交易和程序化量化研究相关经验者优先考虑。\\n7. 兼有机器学习经验者尤佳。\"}","jobCity":"北京","jobCityList":["北京"],"jobAddress":"","careerJobId":142959,"careerJobName":null,"deliverBegin":1774937281000,"deliverEnd":4930560000000,"graduationYear":"毕业不限","refreshTime":1785466194000,"latestProcessTime":1785223914000,"feedbackDays":0,"durationDays":4,"durationMonths":6,"jobOffer":1,"eduLevel":5000,"salaryType":1,"salaryMin":800,"salaryMax":1000,"salaryMonth":0,"workYearType":0,"dockSource":0,"bigChance":false,"projectId":0,"openConversation":0,"deliverId":0,"jobKeys":"量化,策略,股票","avgProcessRate":80,"autoInviteSwitch":0,"addInternRecruit":0,"jobFlagList":[],"jobFlag":0,"avgProcessDay":9,"avgProcessSec":707846,"hasSigned":false,